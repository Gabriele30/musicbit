# Vite dev/preview proxies same-origin API calls to this address.
API_PROXY_TARGET=http://127.0.0.1:3001
# 4175 avoids Windows/Hyper-V reserved ranges around Vite's usual 5173.
WEB_DEV_PORT=4175
# Fastify (also read from the root .env when started through pnpm).
API_HOST=127.0.0.1
API_PORT=3001
# Local Docker only, bound to loopback.
WEB_PORT=8080
# HTTPS deployment: real DNS name pointing to your Debian server, no scheme.
MUSICBIT_DOMAIN=musicbit.example.com
ACME_EMAIL=you@example.com
# Optional hostname for Vite preview behind Tailscale Serve, no scheme.
# WEB_ALLOWED_HOST=your-machine.your-tailnet.ts.net
# HTTPS test scripts read environment variables from the shell (not this file):
# HTTPS_PORT=4443 HTTPS_UPSTREAM=http://127.0.0.1:4173 HTTPS_HOSTS=optional-hostname
# FFMPEG_PATH=ffmpeg FFPROBE_PATH=ffprobe HLS_DURATION=300

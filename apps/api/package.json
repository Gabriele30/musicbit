{
  "name": "@musicbit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@musicbit/shared": "workspace:*",
    "bgutils-js": "^4.0.3",
    "fastify": "^5.12.5",
    "jsdom": "^30.1.2",
    "youtubei.js": "18.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  },
  "license": "MIT"
}

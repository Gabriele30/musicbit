{
  "name": "@musicbit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@musicbit/shared": "workspace:*",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "@types/node": "^24.19.2"
  }
}

{
  "name": "musicbit",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @musicbit/shared build && pnpm --parallel --filter @musicbit/api --filter @musicbit/web dev",
    "build": "pnpm -r build",
    "start": "pnpm --parallel --filter @musicbit/api --filter @musicbit/web start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter @musicbit/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @musicbit/shared build && vitest run",
    "test:watch": "pnpm --filter @musicbit/shared build && vitest",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "assets": "node scripts/generate-assets.mjs",
    "accounts:create": "node --env-file-if-exists=.env scripts/create-accounts.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:browser": "node scripts/real-audio-smoke.mjs",
    "smoke:audio": "node scripts/audio-live-smoke.mjs",
    "smoke:catalog": "node scripts/catalog-smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:catalog": "node --env-file-if-exists=.env scripts/catalog-benchmark.mjs",
    "benchmark:playback": "node scripts/playback-benchmark.mjs",
    "test:https": "node scripts/https-test.mjs",
    "experiment:hls": "node experiments/hls/server.mjs",
    "experiment:playback": "node --env-file-if-exists=.env experiments/playback/server.mjs",
    "experiment:youtube": "node --env-file-if-exists=.env experiments/youtube-playback/server.mjs",
    "benchmark:youtube": "node --env-file-if-exists=.env scripts/youtube-playback-benchmark.mjs",
    "smoke:youtube:https": "node scripts/youtube-playback-https-smoke.mjs",
    "smoke:hls": "node scripts/hls-smoke.mjs",
    "smoke:playback:https": "node scripts/playback-https-smoke.mjs",
    "smoke:https": "node scripts/https-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "node-forge": "1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "description": "A self-hosted music player with discovery, playlists and a mobile PWA.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gabriele30/musicbit.git"
  }
}
